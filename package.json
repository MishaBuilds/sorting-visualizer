{
  "name": "3d-sort-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D visualizer of real sorting algorithms (Bubble, Quick, Merge, Heap) over up to 50 000 elements, built with TypeScript + Three.js + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
